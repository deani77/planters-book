[Unit]
Description=S3 Estate Info private snapshot service
After=network.target

[Service]
Type=simple
User=s3estate
Group=s3estate
WorkingDirectory=/opt/s3-estate/server
ExecStart=/usr/bin/node /opt/s3-estate/server/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/s3-estate/snapshot.json /var/lib/s3-estate/archive /etc/s3-estate
ReadWritePaths=/var/lib/s3-estate/production
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=32
UMask=0077

[Install]
WantedBy=multi-user.target
